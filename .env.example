PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/maranatha?retryWrites=true&w=majority

# Mot de passe de l'espace pasteur. Obligatoire pour les actions d'administration.
ADMIN_PASSWORD=REMPLACEZ_PAR_UN_MOT_DE_PASSE_LONG

# Origines web autorisées, séparées par des virgules. Vide = compatibilité ouverte.
ALLOWED_ORIGINS=https://maranatha-dl9d.onrender.com

# Cloudinary, nécessaire pour téléverser les prédications audio.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin, nécessaire pour les notifications push.
# Coller le JSON du compte de service sur une seule ligne.
FIREBASE_SERVICE_ACCOUNT={}
