# Port du serveur (optionnel, 5000 par défaut)
PORT=5000

# URI MongoDB Atlas (obligatoire)
# Exemple : mongodb+srv://admin:motdepasse@cluster0.xxxxx.mongodb.net/maranathaDB
MONGO_URI=mongodb+srv://VOTRE_USER:VOTRE_MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/maranathaDB

# Clé Firebase Admin SDK (obligatoire pour les notifications push)
# Obtenez-la depuis : Firebase Console > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
# Copiez TOUT le contenu du fichier JSON sur UNE SEULE LIGNE ici
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"invisible-light-c792e","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}
